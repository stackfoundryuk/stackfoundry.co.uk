package components

templ Base(title string, sessionID string) {
	<!DOCTYPE html>
	<html lang="en" data-theme="black" class="scroll-smooth">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>StackFoundry AI | { title }</title>
			<meta name="description" content="One principal engineer. An AI-powered delivery system. Squad-level output with senior-grade rigour. StackFoundry AI builds what traditional consultancies charge a team of eight to produce."/>
			<link rel="canonical" href="https://stackfoundry.ai/"/>
			<meta property="og:type" content="website"/>
			<meta property="og:url" content="https://stackfoundry.ai/"/>
			<meta property="og:title" content={ "StackFoundry AI | " + title }/>
			<meta property="og:description" content="Principal-led, AI-first software delivery with squad-level output and enterprise-grade engineering discipline."/>
			<meta property="og:image" content="https://stackfoundry.ai/img/anvil-stacks.png"/>
			<meta property="twitter:card" content="summary_large_image"/>
			<meta property="twitter:url" content="https://stackfoundry.ai/"/>
			<meta property="twitter:title" content={ "StackFoundry AI | " + title }/>
			<meta property="twitter:description" content="Principal-led, AI-first software delivery with squad-level output and enterprise-grade engineering discipline."/>
			<meta property="twitter:image" content="https://stackfoundry.ai/img/anvil-stacks.png"/>
			<script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Organization",
        "name": "StackFoundry AI",
        "url": "https://stackfoundry.ai",
        "logo": "https://stackfoundry.ai/img/anvil-stacks.png",
        "foundingDate": "2025",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "20 Wenlock Road",
          "addressLocality": "London",
          "postalCode": "N1 7GU",
          "addressCountry": "UK"
        },
        "sameAs": [
          "https://github.com/stackfoundryuk",
          "https://www.linkedin.com/company/stack-foundry-ai"
        ]
      }
      </script>
			<link href="/css/output.css?v=1" rel="stylesheet"/>
			<link rel="preconnect" href="https://fonts.googleapis.com">
			<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
			<link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@100..800&family=Space+Grotesk:wght@300..700&display=swap" rel="stylesheet" media="print" onload="this.media='all'">
			<link rel="icon" type="image/svg+xml" href="/img/favicon-stroke.svg?v=2"/>
			<script src="/js/htmx.min.js?v=1" defer></script>
		</head>
		<body
			class="bg-base-100 text-base-content min-h-screen flex flex-col selection:bg-primary selection:text-black"
			hx-headers={ `{"X-Session-ID": "` + sessionID + `"}` }
		>
			@Header()
			<main class="flex-grow relative">
				{ children... }
			</main>
			@Footer()
		</body>
	</html>
}
