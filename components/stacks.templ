package components

templ Stacks() {
	<section id="stacks" class="py-24 bg-base-200 border-t-2 border-base-content/5">
		<div class="container mx-auto px-4">
			<div class="mb-16 max-w-3xl">
				<h2 class="text-xs font-mono font-bold text-primary tracking-widest uppercase mb-4">&#47;&#47; The Delivery Engine</h2>
				<h3 class="text-4xl md:text-5xl font-display font-bold uppercase leading-[0.9]">
					The Right Tool
					<br/>
					<span class="text-base-content/30">For Each Constraint.</span>
				</h3>
				<p class="mt-6 font-mono text-base-content/70 text-lg">
					We do not wrap every problem in an LLM. We select the fastest path to business value -
					whether that is AI generation, a deterministic algorithm, or a hybrid pipeline. Every
					choice is backed by over a decade of production experience and the academic rigour to
					know the difference and defend the decision.
				</p>
			</div>
			// The Grid - Matching Services Style
			<div class="grid grid-cols-1 md:grid-cols-2 gap-0 border-t-2 border-l-2 border-base-content/10">
				// STACK 1: GoTH (Speed & Simplicity)
				<div class="flex flex-col p-10 border-b-2 border-r-2 border-base-content/10 hover:bg-base-100 transition-all duration-300 group h-full">
					<div class="font-mono text-xs text-primary mb-4 opacity-50 group-hover:opacity-100 transition-opacity uppercase">
						&#47;&#47; Core Product Engineering
					</div>
					<h4 class="text-2xl font-display font-bold uppercase mb-4">GoTH Delivery Core</h4>
					<p class="font-mono text-sm opacity-70 mb-8 leading-relaxed flex-grow">
						Our default for resilient, high-throughput products.
						Go, Templ, and HTMX deliver fast iteration, predictable performance, and low operational overhead.
					</p>
					<div class="flex flex-wrap gap-2 mt-auto">
						@Badge("Go (Golang)")
						@Badge("Templ")
						@Badge("HTMX")
						@Badge("Postgres")
						@Badge("SQLite")
						@Badge("Docker")
						@Badge("Hyperscript")
					</div>
				</div>
				// STACK 2: T3 / Modern JS (Interactivity)
				<div class="flex flex-col p-10 border-b-2 border-r-2 border-base-content/10 hover:bg-base-100 transition-all duration-300 group h-full">
					<div class="font-mono text-xs text-primary mb-4 opacity-50 group-hover:opacity-100 transition-opacity uppercase">
						&#47;&#47; Rich Product Interfaces
					</div>
					<h4 class="text-2xl font-display font-bold uppercase mb-4">Modern JS / T3</h4>
					<p class="font-mono text-sm opacity-70 mb-8 leading-relaxed flex-grow">
						For interaction-heavy products and dashboards.
						We retain type-safe end-to-end delivery while using AI-assisted generation to accelerate frontend throughput.
					</p>
					<div class="flex flex-wrap gap-2 mt-auto">
						@Badge("TypeScript")
						@Badge("React")
						@Badge("Next.js")
						@Badge("Node.js")
						@Badge("Chakra UI")
						@Badge("Tailwind")
						@Badge("Vite")
						@Badge("Zod")
					</div>
				</div>
				// STACK 3: Serverless (Scale)
				<div class="flex flex-col p-10 border-b-2 border-r-2 border-base-content/10 hover:bg-base-100 transition-all duration-300 group h-full">
					<div class="font-mono text-xs text-primary mb-4 opacity-50 group-hover:opacity-100 transition-opacity uppercase">
						&#47;&#47; Scalable Cloud Runtime
					</div>
					<h4 class="text-2xl font-display font-bold uppercase mb-4">Serverless AWS</h4>
					<p class="font-mono text-sm opacity-70 mb-8 leading-relaxed flex-grow">
						Event-driven architectures designed for scale and cost control. Pulumi-managed
						infrastructure in Go gives reproducible environments, unified AWS and Cloudflare
						management, and safer release velocity across every environment.
					</p>
					<div class="flex flex-wrap gap-2 mt-auto">
						@Badge("AWS Lambda")
						@Badge("EventBridge")
						@Badge("SQS/SNS")
						@Badge("Step Functions")
						@Badge("DynamoDB")
						@Badge("Pulumi")
					</div>
				</div>
				// STACK 4: Data / AI (Intelligence)
				<div class="flex flex-col p-10 border-b-2 border-r-2 border-base-content/10 hover:bg-base-100 transition-all duration-300 group h-full">
					<div class="font-mono text-xs text-primary mb-4 opacity-50 group-hover:opacity-100 transition-opacity uppercase">
						&#47;&#47; Applied AI Systems
					</div>
					<h4 class="text-2xl font-display font-bold uppercase mb-4">AI / ML Engineering</h4>
					<p class="font-mono text-sm opacity-70 mb-8 leading-relaxed flex-grow">
						Applied AI where it earns its keep: copilots, retrieval workflows, and domain-specific automation.
						We explicitly balance model quality, latency, and cost against non-AI alternatives.
					</p>
					<div class="flex flex-wrap gap-2 mt-auto">
						@Badge("Python")
						@Badge("Pandas")
						@Badge("TensorFlow")
						@Badge("Pinecone")
						@Badge("Neo4j")
						@Badge("Scikit-Learn")
						@Badge("LangChain")
					</div>
				</div>
			</div>
		</div>
	</section>
}

// Helper component
templ Badge(text string) {
	<span class="inline-flex items-center px-3 py-1 border-2 border-base-content/10 font-mono text-xs uppercase font-bold text-base-content/60 hover:border-primary hover:text-primary cursor-default transition-colors bg-base-100">
		{ text }
	</span>
}
